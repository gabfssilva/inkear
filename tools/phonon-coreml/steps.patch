+/// The flow net's time condition for each of `steps` Euler steps, as `lsd_decode` takes them:
+/// step `i` goes from `s = i / steps` to `t = (i + 1) / steps`, and the net sees the two
+/// embeddings averaged, as `SimpleMLPAdaLN::forward` does.
+pub fn step_times(wt: &Weights, steps: usize, norm: TimeNorm) -> Result<Vec<Vec<f32>>, String> {
+    if steps == 0 {
+        return Err("the flow takes at least one step".into());
+    }
+    (0..steps)
+        .map(|i| {
+            let s = time_embed(wt, 0, i as f32 / steps as f32, norm)?;
+            let t = time_embed(wt, 1, (i + 1) as f32 / steps as f32, norm)?;
+            Ok(s.iter().zip(&t).map(|(a, b)| (a + b) * 0.5).collect())
+        })
+        .collect()
+}
