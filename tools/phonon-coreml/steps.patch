+/// Take `steps` Euler steps of the flow per frame from the next `ptts_speak` on: more is cleaner
+/// and slower, each costing one more run of the flow net. A bundle starts at its checkpoint's
+/// own number. Returns false on failure; see `ptts_last_error`.
+///
+/// # Safety
+/// `h` must come from `ptts_new`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_set_steps(h: *mut PttsHandle, steps: u32) -> bool {
+    let h = unsafe { &mut *h };
+    match guarded(|| h.engine.set_steps(steps as usize)) {
+        Ok(()) => true,
+        Err(e) => {
+            h.last_error = Some(c_string(&e));
+            false
+        }
+    }
+}
+
+/// Euler steps of the flow per frame, as `ptts_set_steps` last set them.
+///
+/// # Safety
+/// `h` must come from `ptts_new`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_steps(h: *const PttsHandle) -> u32 {
+    unsafe { (*h).engine.steps() as u32 }
+}
